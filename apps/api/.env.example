# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
APP_NAME="SegueIT Projects"
PORT=4000
API_PREFIX=api
# Comma separated list of browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# ─── Database ─────────────────────────────────────────────────
# SQLite works out of the box. For PostgreSQL change the provider in
# prisma/schema.prisma to "postgresql" and use a postgres:// URL.
DATABASE_URL="file:./dev.db"

# ─── Authentication ───────────────────────────────────────────
JWT_ACCESS_SECRET=__GENERATE_SECRET__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=__GENERATE_SECRET__
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
ACCESS_COOKIE_NAME=sptms_at
REFRESH_COOKIE_NAME=sptms_rt
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# ─── Rate limiting ────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=20

# ─── Pagination ───────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200

# ─── Seed (used by `npm run db:seed`) ─────────────────────────
SEED_ORG_NAME=SegueIT
SEED_ADMIN_EMAIL=admin@segueit.com
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
SEED_DEMO_DATA=true
SEED_DEMO_USER_PASSWORD=Welcome@123
