# ─── Branding ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="SegueIT Projects"
NEXT_PUBLIC_APP_SHORT_NAME="SegueIT"
NEXT_PUBLIC_APP_TAGLINE="Plan, track and deliver every project with confidence."
NEXT_PUBLIC_COMPANY_NAME="SegueIT"
# Default brand color; each organization can override it in Settings → Organization
NEXT_PUBLIC_BRAND_COLOR="#2563eb"
# Default logo (file in apps/web/public). Each organization can override it in Settings → Organization
NEXT_PUBLIC_LOGO_URL=/segueit-logo.png

# ─── API ──────────────────────────────────────────────────────
# Browser calls go to this same-origin path and are proxied to API_PROXY_TARGET,
# so auth cookies stay first-party.
NEXT_PUBLIC_API_BASE_PATH=/api
API_PROXY_TARGET=http://localhost:4000/api

# Must match REFRESH_COOKIE_NAME in apps/api/.env (used by route protection)
AUTH_REFRESH_COOKIE_NAME=sptms_rt

# ─── UI preferences ───────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
# Upper bound used for board / gantt views that load every task of a project
NEXT_PUBLIC_BOARD_PAGE_SIZE=200
NEXT_PUBLIC_NOTIFICATION_POLL_MS=30000
NEXT_PUBLIC_DATE_FORMAT="dd MMM yyyy"
